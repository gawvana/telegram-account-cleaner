# Telegram Bot Credentials
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
WEBHOOK_SECRET_TOKEN=your_random_webhook_secret_token

# Note: Telegram MTProto credentials (API ID & API Hash) are provided by
# each individual user in the CLIN interface and are not stored in server .env.

# Database and Storage
DATABASE_PATH=cleaner.db
SESSION_DIR=sessions
LOG_LEVEL=INFO

# Telegram Mini App
WEBAPP_URL=https://your-domain.example
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Security & Encryption (Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_MASTER_KEY=
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Legal & Compliance
AGREEMENT_VERSION=1
PRIVACY_VERSION=1

# Scheduler Settings (disabled in serverless)
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# Internationalization
DEFAULT_LANGUAGE=ru

# Welcome Video
START_VIDEO_PATH=assets/welcome.mp4
# START_VIDEO_FILE_ID=BAACAg...
